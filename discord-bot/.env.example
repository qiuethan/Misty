# Discord application credentials (Discord Developer Portal)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional dedicated TESTING guild. Commands ALWAYS register globally (prod) for
# every server the bot joins. If you set this to a test server's ID, commands are
# ALSO registered there for instant updates while developing (global commands can
# take ~1h to propagate). Leave BLANK in production.
DISCORD_GUILD_ID=

# team-tracking directory API. Issue a key with:
#   cd team-tracking && uv run team-tracking-keys issue --name discord-bot \
#     --scopes people:read identifiers:read identifiers:write
DIRECTORY_BASE_URL=http://localhost:8000
DIRECTORY_API_KEY=
