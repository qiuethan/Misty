# Discord application credentials (Discord Developer Portal)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Dedicated TESTING guild ID. Beta commands (those marked `export const beta =
# true`) register EXCLUSIVELY to this guild — they never reach production. Stable
# commands always register globally regardless. Required only if you have beta
# commands; leave blank otherwise.
DISCORD_GUILD_ID=

# team-tracking directory API. Issue a key with:
#   cd services/team-tracking && uv run team-tracking-keys issue --name discord-bot \
#     --scopes people:read people:write identifiers:read identifiers:write
DIRECTORY_BASE_URL=http://localhost:8000
DIRECTORY_API_KEY=

DOC_BASE_URL=http://localhost:8001
DOC_API_KEY=dev-api-key-change-me

LLM_BASE_URL=http://localhost:8002
LLM_API_KEY=dev-api-key-change-me

# verification service (email one-time codes for /link)
VERIFICATION_BASE_URL=http://localhost:8003
VERIFICATION_API_KEY=dev-api-key-change-me

# meeting service (/record voice recording -> minutes PDF).
# Leave MEETING_BASE_URL blank to disable /record — the bot boots fine and the
# command reports "not configured" rather than failing.
# Mint MEETING_API_KEY with:
#   uv --project services/meeting run meeting-keys --name discord-bot --scopes meetings
MEETING_BASE_URL=http://localhost:8004
MEETING_API_KEY=dev-api-key-change-me
# Optional: the bot derives ws:// or wss:// from MEETING_BASE_URL. Set this only
# to override that (e.g. a separate WS ingress).
MEETING_WS_URL=
