{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "services/documentation-system/Dockerfile" },
  "deploy": {
    "startCommand": "sh -c 'cd services/documentation-system && uvicorn src.api.app:app --host 0.0.0.0 --port ${PORT}'",
    "preDeployCommand": "sh -c 'cd services/documentation-system && alembic upgrade head'",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
