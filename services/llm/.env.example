# Environment tier: local | staging | production
LLM_ENV=local

# Caller auth: env-bootstrap admin key (change outside local).
API_KEY=dev-api-key-change-me
# Per-consumer keys — a JSON array. Mint entries with `uv run llm-keys --name <consumer> --scopes chat`.
# POST /chat requires the `chat` scope, so a key with "scopes":[] cannot call it.
# CONSUMER_KEYS=[{"name":"reviewer-summaries","prefix":"ab12cd34","key_hash":"$argon2id$...","scopes":["chat"]}]
CONSUMER_KEYS=

# Provider / model (defaults shown match src/config.py)
LLM_PROVIDER=bedrock-converse
LLM_MODEL=claude-sonnet-4-6
# Per-request timeout to the provider, in seconds.
REQUEST_TIMEOUT_S=60
# Whether extended thinking is on when a /chat request omits `thinking`.
THINKING_DEFAULT=true

# Amazon Bedrock (standard AWS credential chain also reads these).
# Usage bills as Amazon Bedrock (credits apply) — do NOT use Claude Platform on AWS.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
