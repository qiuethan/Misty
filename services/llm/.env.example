# Environment tier: local | staging | production
LLM_ENV=local

# Caller auth: env-bootstrap admin key (change outside local).
API_KEY=dev-api-key-change-me
# Per-consumer keys — a JSON array. Mint entries with `uv run llm-keys --name <consumer>`.
# CONSUMER_KEYS=[{"name":"reviewer-summaries","prefix":"ab12cd34","key_hash":"$argon2id$...","scopes":[]}]
CONSUMER_KEYS=

# Provider / model
LLM_PROVIDER=bedrock
LLM_MODEL=claude-sonnet-5
# Per-request timeout to the provider, in seconds.
REQUEST_TIMEOUT_S=60

# Amazon Bedrock (standard AWS credential chain also reads these).
# Usage bills as Amazon Bedrock (credits apply) — do NOT use Claude Platform on AWS.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
