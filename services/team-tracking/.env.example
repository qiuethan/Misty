DATABASE_URL=postgresql+psycopg://team_tracking:dev_password@localhost:5433/team_tracking
API_KEY=dev-api-key-change-me
# Environment tier: local | staging | production
# Default is `local`. Anything other than `local` (staging/production) enables
# the dev:spoof safety gates AND makes the service refuse to boot while API_KEY
# is still the built-in dev default above — set a strong, unique API_KEY there.
TT_ENV=local
